# Minerva Hybrid Screening Framework - Environment Configuration

# PostgreSQL connection string for the feedback store
MINERVA_DB_DSN=postgresql://user:password@localhost:5432/minerva

# Path to configuration directory
MINERVA_CONFIG_DIR=./config

# Logging level
MINERVA_LOG_LEVEL=INFO

# Active classifier: "nli" (Phase 1) or "distilbert" (Phase 2+)
MINERVA_ACTIVE_CLASSIFIER=nli

# Path to fine-tuned DistilBERT model (Phase 2+)
MINERVA_DISTILBERT_MODEL_PATH=./models/distilbert-finetuned

# Embedding model override (default: intfloat/e5-small-v2)
# MINERVA_EMBEDDING_MODEL=intfloat/e5-small-v2

# NLI model override (default: cross-encoder/nli-deberta-v3-small)
# MINERVA_NLI_MODEL=cross-encoder/nli-deberta-v3-small
